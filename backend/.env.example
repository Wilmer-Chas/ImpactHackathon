# Backend
PORT=3001

# AI provider: "openrouter" | "ollama"
# If unset, OpenRouter is used when OPENROUTER_API_KEY is set; otherwise Ollama.
AI_PROVIDER=openrouter

# OpenRouter (cloud) — Authorization: Bearer <OPENROUTER_API_KEY>
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional OpenRouter ranking headers
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=Impact

# SQLite + hybrid RAG
DATABASE_PATH=
# MOCK_DATA_DIR=  # defaults to repo-root mock-data/
RAG_TOP_K=12

# Local Ollama (used when AI_PROVIDER=ollama, or when no OpenRouter key is set)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
